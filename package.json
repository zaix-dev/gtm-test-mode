{
  "name": "@zaix/gtm-test-mode",
  "version": "1.0.1",
  "description": "A React hook and component to enable a test mode for GTM, allowing event validation without executing conversion actions.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "author": "zaix-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zaix-dev/gtm-test-mode.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "gtm",
    "google-tag-manager",
    "testing",
    "analytics"
  ],
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^13.5.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^18.0.0",
    "ts-jest": "^29.4.6",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  }
}
